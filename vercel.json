{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "framework": "vite",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)nan-react'",
  "rewrites": [
    { "source": "/api/otp",            "destination": "/api/otp" },
    { "source": "/api/chat",           "destination": "/api/chat" },
    { "source": "/api/misc",           "destination": "/api/misc" },
    { "source": "/api/marketplace",    "destination": "/api/marketplace" },
    { "source": "/api/onramp-session", "destination": "/api/onramp-session" },
    { "source": "/api/faucet",         "destination": "/api/faucet" },
    { "source": "/api/listings",       "destination": "/api/listings" },
    { "source": "/api/wallets",        "destination": "/api/wallets" },
    { "source": "/api/wallet",         "destination": "/api/wallet" },
    { "source": "/(.*)",               "destination": "/index.html" }
  ]
}
